{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://stackstate.io/example.json",
  "type": "object",
  "default": {},
  "title": "SUSE Observability Helm chart values",
  "required": [
    "stackstate",
    "clusterAgent"
  ],
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "stackstate": {
              "required": ["url"],
              "properties": {"url": {"type": "string", "minLength": 1}}
            }
          }
        },
        {
          "required": ["global"],
          "properties": {
            "global": {
              "required": ["url"],
              "properties": {
                "url": {
                  "required": ["fromSecret"],
                  "properties": {"fromSecret": {"type": "string", "minLength": 1}}
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "properties": {
            "stackstate": {
              "required": ["cluster"],
              "properties": {
                "cluster": {
                  "required": ["name"],
                  "properties": {"name": {"type": "string", "minLength": 1}}
                }
              }
            }
          }
        },
        {
          "required": ["global"],
          "properties": {
            "global": {
              "required": ["clusterName"],
              "properties": {
                "clusterName": {
                  "required": ["fromSecret"],
                  "properties": {"fromSecret": {"type": "string", "minLength": 1}}
                }
              }
            }
          }
        }
      ]
    }
  ],
  "properties": {
    "stackstate": {
      "type": "object",
      "required": [
        "cluster"
      ],
      "properties": {
        "apiKey": {
          "type": [ "string", "null" ]
        },
        "cluster": {
          "type": "object",
          "properties": {
            "name": {
              "type": ["string", "null"],
              "pattern": "^[a-z0-9]([a-z0-9\\-\\.]*[a-z0-9])$"
            },
            "authToken": {
              "type": "string"
            }
          }
        },
        "url": {
          "type": ["string", "null"]
        }
      }
    },
    "clusterAgent": {
      "type": "object",
      "required": [
        "config"
      ],
      "properties": {
        "config": {
          "type": "object",
          "required": [
            "events"
          ],
          "properties": {
            "events": {
              "type": "object",
              "properties": {
                "categories": {
                  "type": "object",
                  "patternProperties": {
                    ".*": {
                      "type": [
                        "string"
                      ],
                      "enum": [
                        "Alerts",
                        "Activities",
                        "Changes",
                        "Others"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "logsAgent": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "otelLogsAgent": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "resources",
        "skipSslValidation",
        "serviceaccount"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "pullSecretName": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "resources": {
          "type": "object",
          "required": [
            "limits"
          ],
          "properties": {
            "limits": {
              "type": "object",
              "required": [
                "memory"
              ],
              "properties": {
                "memory": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              }
            }
          }
        },
        "skipSslValidation": {
          "type": "boolean"
        },
        "serviceaccount": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "global": {
      "type": "object",
      "properties": {
        "features": {
          "type": "object",
          "properties": {
            "experimentalOtelLogsAgent": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
