{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://stackstate.io/example.json",
  "type": "object",
  "default": {},
  "title": "SUSE Observability Helm chart values",
  "required": [
    "stackstate",
    "clusterAgent"
  ],
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "stackstate": {
              "required": ["url"],
              "properties": {"url": {"type": "string", "minLength": 1}}
            }
          }
        },
        {
          "required": ["global"],
          "properties": {
            "global": {
              "required": ["url"],
              "properties": {
                "url": {
                  "required": ["fromSecret"],
                  "properties": {"fromSecret": {"type": "string", "minLength": 1}}
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "properties": {
            "stackstate": {
              "required": ["cluster"],
              "properties": {
                "cluster": {
                  "required": ["name"],
                  "properties": {"name": {"type": "string", "minLength": 1}}
                }
              }
            }
          }
        },
        {
          "required": ["global"],
          "properties": {
            "global": {
              "required": ["clusterName"],
              "properties": {
                "clusterName": {
                  "required": ["fromSecret"],
                  "properties": {"fromSecret": {"type": "string", "minLength": 1}}
                }
              }
            }
          }
        }
      ]
    }
  ],
  "properties": {
    "stackstate": {
      "type": "object",
      "required": [
        "cluster"
      ],
      "properties": {
        "apiKey": {
          "type": [ "string", "null" ]
        },
        "cluster": {
          "type": "object",
          "properties": {
            "name": {
              "type": ["string", "null"],
              "pattern": "^[a-z0-9]([a-z0-9\\-\\.]*[a-z0-9])$"
            },
            "authToken": {
              "type": "string"
            }
          }
        },
        "url": {
          "type": ["string", "null"]
        }
      }
    },
    "clusterAgent": {
      "type": "object",
      "required": [
        "config"
      ],
      "properties": {
        "config": {
          "type": "object",
          "required": [
            "events"
          ],
          "properties": {
            "events": {
              "type": "object",
              "properties": {
                "categories": {
                  "type": "object",
                  "patternProperties": {
                    ".*": {
                      "type": [
                        "string"
                      ],
                      "enum": [
                        "Alerts",
                        "Activities",
                        "Changes",
                        "Others"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
