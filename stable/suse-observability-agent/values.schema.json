{
  "$schema": "https://json-schema.org/draft/2019-09/schema",
  "$id": "https://stackstate.io/example.json",
  "type": "object",
  "default": {},
  "title": "SUSE Observability Helm chart values",
  "required": [
    "stackstate",
    "clusterAgent"
  ],
  "allOf": [
    {
      "anyOf": [
        {
          "properties": {
            "stackstate": {
              "required": ["url"],
              "properties": {"url": {"type": "string", "minLength": 1}}
            }
          }
        },
        {
          "required": ["global"],
          "properties": {
            "global": {
              "required": ["url"],
              "properties": {
                "url": {
                  "required": ["fromSecret"],
                  "properties": {"fromSecret": {"type": "string", "minLength": 1}}
                }
              }
            }
          }
        }
      ]
    },
    {
      "anyOf": [
        {
          "properties": {
            "stackstate": {
              "required": ["cluster"],
              "properties": {
                "cluster": {
                  "required": ["name"],
                  "properties": {"name": {"type": "string", "minLength": 1}}
                }
              }
            }
          }
        },
        {
          "required": ["global"],
          "properties": {
            "global": {
              "required": ["clusterName"],
              "properties": {
                "clusterName": {
                  "required": ["fromSecret"],
                  "properties": {"fromSecret": {"type": "string", "minLength": 1}}
                }
              }
            }
          }
        }
      ]
    }
  ],
  "properties": {
    "stackstate": {
      "type": "object",
      "required": [
        "cluster"
      ],
      "properties": {
        "apiKey": {
          "type": [ "string", "null" ]
        },
        "cluster": {
          "type": "object",
          "properties": {
            "name": {
              "type": ["string", "null"],
              "pattern": "^[a-z0-9]([a-z0-9\\-\\.]*[a-z0-9])$"
            },
            "authToken": {
              "type": "string"
            }
          }
        },
        "url": {
          "type": ["string", "null"]
        }
      }
    },
    "nodeAgent": {
      "type": "object",
      "properties": {
        "containerRuntime": {
          "type": "object",
          "properties": {
            "mountDefaultSockets": {
              "type": "boolean",
              "description": "Mount the default Docker, containerd and CRI-O sockets alongside any custom socket. When false, only a configured custom socket is mounted and validated as a socket."
            }
          }
        }
      }
    },
    "clusterAgent": {
      "type": "object",
      "required": [
        "config"
      ],
      "properties": {
        "config": {
          "type": "object",
          "required": [
            "events"
          ],
          "properties": {
            "events": {
              "type": "object",
              "properties": {
                "categories": {
                  "type": "object",
                  "patternProperties": {
                    ".*": {
                      "type": [
                        "string"
                      ],
                      "enum": [
                        "Alerts",
                        "Activities",
                        "Changes",
                        "Others"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "logsAgent": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "otelLogsAgent": {
      "type": "object",
      "required": [
        "enabled",
        "image",
        "resources",
        "skipSslValidation",
        "serviceaccount"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "exportMode": {
          "type": "string",
          "enum": [
            "auto",
            "promtail",
            "native"
          ]
        },
        "image": {
          "type": "object",
          "required": [
            "repository",
            "tag",
            "pullPolicy"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            },
            "pullSecretName": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "resources": {
          "type": "object",
          "required": [
            "limits"
          ],
          "properties": {
            "limits": {
              "type": "object",
              "required": [
                "memory"
              ],
              "properties": {
                "memory": {
                  "type": ["string", "number"]
                }
              }
            }
          }
        },
        "skipSslValidation": {
          "type": "boolean"
        },
        "serviceaccount": {
          "type": "object",
          "properties": {
            "annotations": {
              "type": "object"
            }
          }
        }
      }
    },
    "otel": {
      "type": "object",
      "properties": {
        "telemetryGateway": {
          "type": "object",
          "properties": {
            "traceSampling": {
              "type": "object",
              "required": ["decisionWait", "numTraces", "decisionCache"],
              "properties": {
                "decisionWait": {
                  "type": "string",
                  "description": "Positive duration to wait after first receiving a trace before making a sampling decision.",
                  "allOf": [
                    {
                      "pattern": "^\\+?(([0-9]+(\\.[0-9]*)?|\\.[0-9]+)(ns|us|µs|μs|ms|s|m|h))+$"
                    },
                    {
                      "pattern": "[1-9]"
                    }
                  ]
                },
                "numTraces": {
                  "type": "integer",
                  "minimum": 1,
                  "description": "Maximum number of trace entries held by each sampling collector."
                },
                "decisionCache": {
                  "type": "object",
                  "required": ["sampledCacheSize", "nonSampledCacheSize"],
                  "properties": {
                    "sampledCacheSize": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Number of keep decisions remembered after trace-buffer release; zero disables the cache."
                    },
                    "nonSampledCacheSize": {
                      "type": "integer",
                      "minimum": 0,
                      "description": "Number of drop decisions remembered after trace-buffer release; zero disables the cache."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "global": {
      "type": "object",
      "properties": {
        "features": {
          "type": "object",
          "properties": {
            "experimentalOtelLogsAgent": {
              "type": "boolean"
            },
            "experimentalOtelKubernetesClusterAgent": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
