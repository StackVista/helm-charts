{
  "apiVersion": "apps/v1",
  "kind": "Deployment",
  "metadata": {
    "labels": {
      "app": "prometheus-elasticsearch-exporter",
      "heritage": "Helm",
      "release": "nightly"
    },
    "name": "nightly-prometheus-elasticsearch-exporter"
  },
  "spec": {
    "replicas": 1,
    "selector": {
      "matchLabels": {
        "app": "prometheus-elasticsearch-exporter",
        "release": "nightly"
      }
    },
    "strategy": {
      "rollingUpdate": {
        "maxSurge": 1,
        "maxUnavailable": 0
      },
      "type": "RollingUpdate"
    },
    "template": {
      "metadata": {
        "annotations": {
          "ad.stackstate.com/exporter.check_names": "[\"openmetrics\"]",
          "ad.stackstate.com/exporter.init_configs": "[{}]",
          "ad.stackstate.com/exporter.instances": "[ { \"prometheus_url\": \"http://%%host%%:9108/metrics\", \"namespace\": \"stackstate\", \"metrics\": [\"elasticsearch_indices_store_*\", \"elasticsearch_cluster_health_*\"] } ]"
        },
        "labels": {
          "app": "prometheus-elasticsearch-exporter",
          "release": "nightly"
        }
      },
      "spec": {
        "containers": [
          {
            "command": [
              "elasticsearch_exporter",
              "--log.format=logfmt",
              "--log.level=info",
              "--es.uri=http://suse-observability-elasticsearch-master:9200",
              "--es.all",
              "--es.indices",
              "--es.indices_settings",
              "--es.indices_mappings",
              "--es.shards",
              "--collector.snapshots",
              "--es.timeout=30s",
              "--es.ca=/ssl/ca.pem",
              "--es.client-cert=/ssl/client.pem",
              "--es.client-private-key=/ssl/client.key",
              "--web.listen-address=:9108",
              "--web.telemetry-path=/metrics"
            ],
            "env": [
              {
                "name": "TEST_KEY",
                "valueFrom": {
                  "secretKeyRef": {
                    "key": "key",
                    "name": "customer-key"
                  }
                }
              }
            ],
            "envFrom": [
              {
                "secretRef": {
                  "name": "customer-environment"
                }
              }
            ],
            "image": "my.registry.com/stackstate/elasticsearch-exporter:naming-fixture",
            "imagePullPolicy": "IfNotPresent",
            "lifecycle": {
              "preStop": {
                "exec": {
                  "command": [
                    "/bin/sleep",
                    "20"
                  ]
                }
              }
            },
            "livenessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": "http"
              },
              "initialDelaySeconds": 5,
              "periodSeconds": 5,
              "timeoutSeconds": 5
            },
            "name": "exporter",
            "ports": [
              {
                "containerPort": 9108,
                "name": "http"
              }
            ],
            "readinessProbe": {
              "httpGet": {
                "path": "/healthz",
                "port": "http"
              },
              "initialDelaySeconds": 1,
              "periodSeconds": 5,
              "timeoutSeconds": 5
            },
            "resources": {
              "limits": {
                "cpu": "100m",
                "ephemeral-storage": "1Gi",
                "memory": "100Mi"
              },
              "requests": {
                "cpu": "100m",
                "ephemeral-storage": "1Mi",
                "memory": "100Mi"
              }
            },
            "securityContext": {
              "allowPrivilegeEscalation": false,
              "capabilities": {
                "drop": [
                  "ALL"
                ]
              },
              "readOnlyRootFilesystem": true
            },
            "volumeMounts": [
              {
                "mountPath": "/ssl",
                "name": "ssl"
              },
              {
                "mountPath": "/customer-tls",
                "name": "external-tls"
              }
            ]
          }
        ],
        "restartPolicy": "Always",
        "securityContext": {
          "runAsNonRoot": true,
          "runAsUser": 1000,
          "seccompProfile": {
            "type": "RuntimeDefault"
          }
        },
        "serviceAccountName": "nightly-prometheus-elasticsearch-exporter",
        "volumes": [
          {
            "name": "ssl",
            "secret": {
              "secretName": "nightly-prometheus-elasticsearch-exporter-cert"
            }
          },
          {
            "name": "external-tls",
            "secret": {
              "secretName": "customer-tls"
            }
          }
        ]
      }
    }
  }
}
