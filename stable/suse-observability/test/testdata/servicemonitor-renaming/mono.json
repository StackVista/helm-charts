{
  "correlate": {
    "apiVersion": "monitoring.coreos.com/v1",
    "kind": "ServiceMonitor",
    "metadata": {
      "annotations": {
        "fixture-owner": "observability"
      },
      "labels": {
        "app.kubernetes.io/component": "correlate",
        "app.kubernetes.io/component-group": "correlate",
        "app.kubernetes.io/instance": "nightly",
        "app.kubernetes.io/managed-by": "Helm",
        "app.kubernetes.io/name": "suse-observability",
        "fixture-scope": "preserved",
        "prometheus": "platform-monitoring"
      },
      "name": "nightly-suse-observability-correlate",
      "namespace": "monitoring"
    },
    "spec": {
      "endpoints": [
        {
          "interval": "20s",
          "path": "/metrics",
          "port": "metrics",
          "relabelings": [
            {
              "action": "replace",
              "regex": "(.+)",
              "sourceLabels": [
                "__meta_kubernetes_pod_label_app_kubernetes_io_name"
              ],
              "targetLabel": "app_name"
            },
            {
              "action": "replace",
              "regex": "(.+)",
              "sourceLabels": [
                "__meta_kubernetes_pod_label_app_kubernetes_io_component"
              ],
              "targetLabel": "app_component"
            }
          ],
          "scheme": "http"
        }
      ],
      "namespaceSelector": {
        "matchNames": [
          "observability"
        ]
      },
      "podTargetLabels": [
        "__meta_kubernetes_pod_label_app_kubernetes_io_name",
        "__meta_kubernetes_pod_label_app_kubernetes_io_component"
      ],
      "selector": {
        "matchLabels": {
          "app.kubernetes.io/component": "correlate",
          "app.kubernetes.io/instance": "nightly",
          "app.kubernetes.io/name": "suse-observability"
        }
      }
    }
  },
